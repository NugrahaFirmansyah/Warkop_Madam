# ========================================================
# WARKOP MADAM - TEMPLATE ENVIRONMENT (.env.example)
# ========================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Di cPanel / Hosting, sesuaikan nama database, user, & password.

# Konfigurasi Aplikasi
APP_NAME="Warkop Madam"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://namadomainanda.com

# Konfigurasi Database MySQL / MariaDB (cPanel / Hosting)
# Contoh cPanel: DB_DATABASE=u123456_warkop | DB_USERNAME=u123456_user
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=warkop_madam
DB_USERNAME=root
DB_PASSWORD=

# Pengaturan Keamanan & Sesi
SESSION_LIFETIME=0
CSRF_PROTECTION=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=10
MAX_UPLOAD_SIZE_MB=4

# Konfigurasi AI Verifikasi Bukti Pembayaran (Google Gemini AI Vision)
# Dapatkan API Key gratis di https://aistudio.google.com/
GEMINI_API_KEY=
AI_VERIFICATION_STRICT_MODE=true
MERCHANT_NAME_WHITELIST="Warkop Madam,Madam,Warkop,Nugraha"

